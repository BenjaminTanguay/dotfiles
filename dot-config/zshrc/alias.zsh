alias ls='eza --color=always --group-directories-first --icons'
alias ll='eza -la --icons --octal-permissions --group-directories-first'
alias lt='eza --tree --level=2 --color=always --group-directories-first --icons'
alias cat='bat --style=plain'
alias cd='z'
alias k='kubectl'

# Ghostty terminals for specific workspaces (persists across monitor changes)
# Use 'open -na' to launch Ghostty.app with arguments on macOS
alias t1="open -na Ghostty --args --title='WS1 - Main Ticket'"
alias t2="open -na Ghostty --args --title='WS2 - Secondary'"
alias t3="open -na Ghostty --args --title='WS3 - Prototyping'"
alias t4="open -na Ghostty --args --title='WS4 - Side Project'"
alias t5="open -na Ghostty --args --title='WS5 - Team Tools'"



